#!/bin/bash -e

rm -f tmp/pids/server.pid
./bin/rails db:prepare
# Falcon in place of Puma; Puma's config also resets connection state at boot.
./bin/rails runner "Membership.disconnect_all"
exec bundle exec falcon serve --bind "http://0.0.0.0:${PORT:-3000}" --forked --count "${WEB_CONCURRENCY:-4}"
